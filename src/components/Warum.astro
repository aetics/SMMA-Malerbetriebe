---
const cards = [
  {
    icon: '🎯',
    title: 'Ich will Praxiserfahrung',
    text: 'Ich baue mein Portfolio auf. Dein Betrieb ist mein erstes reales Projekt – deshalb investiere ich 100% meiner Zeit.',
  },
  {
    icon: '🤝',
    title: 'Kein Risiko für dich',
    text: 'Du verlierst nichts. Kein Vertrag, keine Kosten, keine Verpflichtung. Wenn es dir gefällt, reden wir weiter.',
  },
  {
    icon: '📣',
    title: 'Ich will echte Ergebnisse zeigen',
    text: 'Zahlen aus der Praxis sind wertvoller als jede Theorie. Deine Ergebnisse sind mein bestes Verkaufsargument.',
  },
  {
    icon: '💬',
    title: 'Eine ehrliche Bewertung reicht',
    text: 'Alles, was ich am Ende erbitte, ist dein ehrliches Feedback – ob es funktioniert hat oder nicht.',
  },
];
---
<section
  class="py-24 px-6 text-center"
  style="background: linear-gradient(140deg, #1a1a2e 0%, #16213e 100%)"
>
  <div class="max-w-5xl mx-auto">
    <p class="text-accent text-xs font-bold tracking-[3px] uppercase mb-3">Ehrlichkeit zuerst</p>
    <h2 class="text-3xl font-extrabold text-white mb-4">Warum mache ich das kostenlos?</h2>
    <p class="text-gray-400 max-w-xl mx-auto mb-14">
      Ich baue gerade meine Erfahrungen in der Praxis auf. Du bekommst echte Arbeit –
      ich bekomme einen Erfahrungswert und vielleicht eine Bewertung. Fair Deal.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 text-left">
      {cards.map(c => (
        <div class="bg-white/5 border border-white/10 rounded-xl p-7">
          <div class="text-3xl mb-4">{c.icon}</div>
          <h3 class="text-white font-bold text-sm mb-2">{c.title}</h3>
          <p class="text-gray-400 text-sm">{c.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
