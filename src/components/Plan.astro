---
const weeks = [
  {
    label: 'Woche 1',
    title: 'Analyse & Einrichtung',
    items: [
      'Kurzes Erstgespräch (30 Min.)',
      'Audit: Google, Social, Website',
      'Profile optimieren & vervollständigen',
      'Content-Plan erstellen',
    ],
    highlight: false,
  },
  {
    label: 'Woche 2',
    title: 'Content & Sichtbarkeit',
    items: [
      'Erste Beiträge veröffentlichen',
      'Bewertungs-Aktion starten',
      'Google-Profil mit Fotos füllen',
      'Erste Reichweite aufbauen',
    ],
    highlight: true,
  },
  {
    label: 'Woche 3',
    title: 'Weiter & optimieren',
    items: [
      'Weitere Beiträge & Stories',
      'Auf Kommentare reagieren',
      'Website-Anpassungen umsetzen',
      'Bewertungen weiter sammeln',
    ],
    highlight: false,
  },
  {
    label: 'Woche 4',
    title: 'Abschluss & Übergabe',
    items: [
      'Letzte Beiträge veröffentlichen',
      'Ergebnis-Auswertung erstellen',
      'Feedback-Gespräch (30 Min.)',
      'Empfehlungen für Weiterführung',
    ],
    highlight: false,
  },
];
---
<section id="plan" class="py-24 px-6 bg-gray-50">
  <div class="max-w-5xl mx-auto">
    <p class="text-accent text-xs font-bold tracking-[3px] uppercase mb-3">Der Ablauf</p>
    <h2 class="text-3xl font-extrabold mb-4">Was passiert in den 4 Wochen?</h2>
    <p class="text-gray-500 max-w-lg mb-14">Ein klarer Fahrplan – kein Chaos, kein Aufwand für dich.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 overflow-hidden rounded-2xl shadow-md">
      {weeks.map((w, i) => (
        <div
          class:list={[
            'p-7 border-b sm:border-b-0 sm:border-r border-gray-100 last:border-none',
            w.highlight ? 'bg-primary text-white' : 'bg-white',
          ]}
        >
          <p class:list={['text-xs font-bold tracking-widest uppercase mb-2', w.highlight ? 'text-accent' : 'text-accent']}>
            {w.label}
          </p>
          <h3 class:list={['font-bold text-sm mb-4 leading-snug', w.highlight ? 'text-white' : 'text-primary']}>
            {w.title}
          </h3>
          <ul class="space-y-2">
            {w.items.map(item => (
              <li class:list={[
                'text-xs pb-2 border-b last:border-none',
                w.highlight ? 'text-gray-400 border-white/10' : 'text-gray-500 border-gray-100',
              ]}>
                <span class="text-accent font-bold">✓ </span>{item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
