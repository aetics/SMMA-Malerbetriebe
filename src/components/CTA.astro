---
const mailto =
  'mailto:Ph.Breier@gmx.de' +
  '?subject=Kostenloser%20Marketing-Monat%20Maler' +
  '&body=Hallo%2C%0A%0Aich%20interessiere%20mich%20f%C3%BCr%20den%20kostenlosen%20Marketing-Monat.%0A%0AMein%20Betrieb%3A%20%0AStadt%2FPLZ%3A%20%0ATelefon%3A%20';
---
<section
  id="cta"
  class="py-24 px-6 text-center"
  style="background: linear-gradient(135deg, #e8b84b 0%, #f39c12 100%)"
>
  <div class="max-w-xl mx-auto">
    <h2 class="text-3xl font-extrabold text-primary mb-4">Interesse? Melde dich einfach.</h2>
    <p class="text-primary/70 mb-3">
      Kein langer Prozess. Kein Kleingedrucktes.<br />
      Kurze Nachricht genügt – ich melde mich innerhalb von 24 Stunden.
    </p>
    <p class="text-primary/50 text-sm mb-8">Kein Verkaufsdruck. Kein Risiko. Nur ehrliche Arbeit.</p>
    <a
      href={mailto}
      class="inline-block bg-primary text-accent font-extrabold px-12 py-4 rounded-full
             shadow-[0_4px_20px_rgba(0,0,0,0.2)]
             hover:bg-[#0f0f1e] hover:-translate-y-1 transition-all duration-200"
    >
      Jetzt Nachricht schicken →
    </a>
  </div>
</section>

<footer class="bg-primary text-gray-600 text-center py-8 text-sm">
  <p>
    Kontakt:
    <a href="mailto:Ph.Breier@gmx.de" class="text-accent hover:underline">Ph.Breier@gmx.de</a>
  </p>
</footer>
