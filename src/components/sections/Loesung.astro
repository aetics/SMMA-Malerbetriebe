---
const items = [
  {
    icon: '📱',
    title: 'Social Media Betreuung',
    desc: 'Profile einrichten, Posts erstellen, Vorher-Nachher-Content, Stories & kurze Reels – alles, was zeigt, was ihr könnt.',
    tags: ['Instagram', 'Facebook', 'Reels'],
  },
  {
    icon: '🎯',
    title: 'Lokale Werbeanzeigen',
    desc: 'Gezielte Anzeigen auf Meta und ggf. Google – ausgesteuert auf Freising und Umgebung. Nur potenzielle Kunden in Reichweite.',
    tags: ['Meta Ads', 'Google Ads', 'Zielregion'],
  },
  {
    icon: '⚡',
    title: 'Einfache Lead-Strecke',
    desc: 'Interessenten landen auf einer klaren Seite mit Formular oder WhatsApp-Link. Direkte Anfrage in wenigen Sekunden.',
    tags: ['Landing Page', 'WhatsApp', 'Formular'],
  },
  {
    icon: '📊',
    title: 'Klares Reporting',
    desc: 'Kein Agentur-Kauderwelsch. Eine Seite: Wie viele Anfragen? Was haben sie gekostet? Was hat funktioniert?',
    tags: ['Leads', 'Kosten / Anfrage', 'Monatlich'],
  },
];
---
<section class="relative py-32 px-6 bg-surface overflow-hidden">

  <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-px"
       style="background: linear-gradient(90deg, transparent, rgba(249,115,22,.4), transparent)"></div>

  <div class="max-w-5xl mx-auto">

    <div class="reveal mb-4 flex items-center gap-3">
      <div class="h-px flex-1 max-w-8" style="background:linear-gradient(90deg,#f97316,transparent)"></div>
      <span class="text-orange-500 text-xs font-bold tracking-[3px] uppercase">Was ich übernehme</span>
    </div>

    <h2 class="reveal delay-1 font-black leading-tight mb-5"
        style="font-size: clamp(2rem, 4vw, 3.2rem)">
      Komplett.<br />
      <span class="text-zinc-600">Ohne dass ihr euch täglich</span><br />
      darum kümmern müsst.
    </h2>
    <p class="reveal delay-2 text-zinc-500 text-lg max-w-lg mb-16">
      Alles aus einer Hand – vom ersten Post bis zur fertigen Auswertung.
    </p>

    <div class="grid sm:grid-cols-2 gap-4">
      {items.map((item, i) => (
        <div class:list={['glass rounded-2xl p-8 flex flex-col gap-5 group hover:-translate-y-1 transition-all duration-300 reveal', `delay-${i+2}`]}>
          <div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl"
               style="background:rgba(249,115,22,.1); border:1px solid rgba(249,115,22,.2)">
            {item.icon}
          </div>
          <div>
            <h3 class="text-zinc-100 font-bold text-base mb-2">{item.title}</h3>
            <p class="text-zinc-500 text-sm leading-relaxed">{item.desc}</p>
          </div>
          <div class="flex flex-wrap gap-2 mt-auto pt-2 border-t border-white/5">
            {item.tags.map(t => (
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full"
                    style="background:rgba(249,115,22,.08); color:#fb923c; border:1px solid rgba(249,115,22,.15)">
                {t}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
