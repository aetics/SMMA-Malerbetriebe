---
const steps = [
  { n: '01', title: 'Kurzes Erstgespräch',       dauer: '~30 Min.',  text: '20–30 Minuten per Telefon oder Video. Ich lerne euren Betrieb kennen, eure Ziele und was bisher versucht wurde.' },
  { n: '02', title: 'Check des Auftritts',        dauer: '1–2 Tage', text: 'Website, Google-Profil, Social Media. Ich sage euch ehrlich, wo die größten Lücken sind.' },
  { n: '03', title: 'Testphase startet',           dauer: '4 Wochen', text: 'Klares Startdatum, klare Ziele. Ich lege los. Ihr bekommt regelmäßige Updates ohne Fachjargon.' },
  { n: '04', title: 'Gemeinsame Auswertung',      dauer: 'Danach',   text: 'Ergebnisse, Kosten, Qualität der Anfragen. Dann entscheidet ihr, ob ihr weitermachen wollt.' },
];
---
<section class="relative py-32 px-6 bg-surface overflow-hidden">

  <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-px"
       style="background: linear-gradient(90deg, transparent, rgba(249,115,22,.4), transparent)"></div>

  <div class="max-w-5xl mx-auto">

    <div class="reveal mb-4 flex items-center gap-3">
      <div class="h-px flex-1 max-w-8" style="background:linear-gradient(90deg,#f97316,transparent)"></div>
      <span class="text-orange-500 text-xs font-bold tracking-[3px] uppercase">Ablauf</span>
    </div>

    <h2 class="reveal delay-1 font-black leading-tight mb-16"
        style="font-size: clamp(2rem, 4vw, 3.2rem)">
      Schritt für Schritt.<br />
      <span class="text-zinc-600">In wenigen Tagen startklar.</span>
    </h2>

    <div class="flex flex-col gap-4">
      {steps.map((s, i) => (
        <div class:list={['glass rounded-2xl p-7 flex gap-6 items-start group hover:border-orange-500/30 transition-all duration-300 reveal', `delay-${i+2}`]}>
          <!-- Big number -->
          <div class="shrink-0 w-14 h-14 rounded-2xl flex items-center justify-center font-black text-lg
                      transition-all duration-300 group-hover:scale-110"
               style="background:rgba(249,115,22,.08); border:1px solid rgba(249,115,22,.2); color:#f97316">
            {s.n}
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-4 mb-2">
              <h3 class="text-zinc-100 font-bold">{s.title}</h3>
              <span class="shrink-0 text-xs font-semibold px-3 py-1 rounded-full"
                    style="background:rgba(249,115,22,.08); color:#fb923c; border:1px solid rgba(249,115,22,.15)">
                {s.dauer}
              </span>
            </div>
            <p class="text-zinc-500 text-sm leading-relaxed">{s.text}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
