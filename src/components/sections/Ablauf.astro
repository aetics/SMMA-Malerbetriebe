---
const schritte = [
  {
    nr: '1',
    title: 'Kurzes Erstgespräch',
    text: '20–30 Minuten per Telefon oder Video. Ich verstehe, wie euer Betrieb tickt, welche Aufträge ihr wollt und was bisher schon versucht wurde.',
    dauer: '~30 Min.',
  },
  {
    nr: '2',
    title: 'Check des Online-Auftritts',
    text: 'Ich schaue mir an, was ihr aktuell habt – Website, Google-Profil, Social Media. Dann sage ich euch ehrlich, wo die größten Lücken sind.',
    dauer: '1–2 Tage',
  },
  {
    nr: '3',
    title: 'Testphase startet',
    text: 'Klares Startdatum, klare Ziele. Ich lege los: Profile, Content, Anzeigen. Ihr bekommt regelmäßige Updates – ohne Fachjargon.',
    dauer: '4 Wochen',
  },
  {
    nr: '4',
    title: 'Gemeinsame Auswertung',
    text: 'Nach 4 Wochen sitzen wir zusammen. Was hat funktioniert? Wie war die Qualität der Anfragen? Dann entscheidet ihr, ob ihr weitermachen wollt.',
    dauer: 'Danach',
  },
];
---
<section class="py-28 px-6 bg-neutral-950">
  <div class="max-w-5xl mx-auto">

    <p class="text-brand text-xs font-bold tracking-[3px] uppercase mb-4">Ablauf & Zusammenarbeit</p>
    <h2 class="text-4xl sm:text-5xl font-black mb-5 leading-tight">
      Wie es läuft –<br />Schritt für Schritt.
    </h2>
    <p class="text-neutral-400 text-lg max-w-xl mb-16">
      Kein komplizierter Prozess. Kein monatelanger Vorlauf.
      In wenigen Tagen sind wir startklar.
    </p>

    <div class="relative">
      <!-- vertical line -->
      <div class="hidden sm:block absolute left-7 top-10 bottom-10 w-px bg-border"></div>

      <div class="flex flex-col gap-6">
        {schritte.map(s => (
          <div class="sm:pl-20 relative flex flex-col sm:flex-row gap-5 items-start">
            <!-- circle -->
            <div class="hidden sm:flex absolute left-0 top-0 w-14 h-14 rounded-full bg-brand/10 border border-brand/30
                        items-center justify-center text-brand font-black text-lg shrink-0 z-10">
              {s.nr}
            </div>
            <div class="bg-card border border-border rounded-2xl p-7 flex-1 hover:border-brand/40 transition-colors">
              <div class="flex items-start justify-between gap-4 mb-3">
                <h3 class="text-white font-bold text-lg">{s.title}</h3>
                <span class="shrink-0 text-xs font-semibold bg-brand/10 text-brand border border-brand/20 px-3 py-1 rounded-full">
                  {s.dauer}
                </span>
              </div>
              <p class="text-neutral-400 text-sm leading-relaxed">{s.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
