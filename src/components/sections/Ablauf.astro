---
const steps = [
  { n:'01', title:'Kurzes Erstgespräch',   d:'~30 Min.',  text:'Telefon oder Video-Call. Ich verstehe euren Betrieb, eure Ziele und was bisher versucht wurde.' },
  { n:'02', title:'Audit des Auftritts',   d:'1–2 Tage',  text:'Website, Google-Profil, Social Media. Ich sage euch ehrlich, wo die größten Lücken sind.' },
  { n:'03', title:'Testphase startet',     d:'4 Wochen',  text:'Klares Startdatum, klare Ziele. Ihr bekommt regelmäßige Updates – ohne Fachjargon.' },
  { n:'04', title:'Gemeinsame Auswertung', d:'Danach',    text:'Anzahl Anfragen, Kosten, Qualität. Dann entscheidet ihr, ob und wie es weitergeht.' },
];
---
<section class="bg-white py-28 px-6">
  <div class="max-w-5xl mx-auto">

    <p class="reveal text-brand text-xs font-bold tracking-[3px] uppercase mb-4">Ablauf</p>

    <h2 class="reveal reveal-d1 font-black text-zinc-900 leading-tight text-4xl sm:text-5xl mb-14">
      Schritt für Schritt.<br/>
      <span class="text-zinc-300">In wenigen Tagen</span> startklar.
    </h2>

    <div class="flex flex-col gap-3">
      {steps.map((s, i) => (
        <div class={`reveal reveal-d${i + 1}
                     group bg-zinc-50 border border-zinc-200 rounded-2xl p-7
                     hover:bg-white hover:border-brand/30
                     hover:shadow-xl hover:shadow-brand/10
                     hover:-translate-y-0.5
                     transition-all duration-300
                     flex gap-5 items-center`}>

          <!-- Number badge -->
          <div class="shrink-0 w-14 h-14 rounded-2xl
                      bg-gradient-to-br from-orange-100 to-amber-50
                      border border-orange-200
                      flex items-center justify-center
                      font-black text-xl text-brand
                      group-hover:scale-110 group-hover:shadow-md group-hover:shadow-brand/20
                      transition-all duration-300">
            {s.n}
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-3 mb-1">
              <h3 class="text-zinc-900 font-bold">{s.title}</h3>
              <span class="text-xs font-bold px-3 py-1 rounded-full
                           bg-brand/8 text-brand border border-brand/20">
                {s.d}
              </span>
            </div>
            <p class="text-zinc-500 text-sm leading-relaxed">{s.text}</p>
          </div>

          <svg class="shrink-0 text-zinc-200 group-hover:text-brand
                       transition-colors duration-300 hidden sm:block"
               width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      ))}
    </div>

  </div>
</section>
