---
const cards = [
  {
    accent: 'from-brand/20 to-amber-400/10 border-brand/25',
    icon: '📸', n: '01',
    title: 'Vorher-Nachher ist King',
    text: 'Kein Content funktioniert besser auf Instagram als ein starkes Vorher-Nachher-Foto. Ihr habt das Rohmaterial – ich mache was draus.',
  },
  {
    accent: 'from-violet-500/15 to-indigo-500/8 border-violet-500/25',
    icon: '📍', n: '02',
    title: 'Lokale Ads, null Streuverlust',
    text: 'Anzeigen gezielt auf Freising und Umgebung. Nur Menschen in eurer Region, die gerade einen Maler suchen.',
  },
  {
    accent: 'from-teal-500/15 to-emerald-500/8 border-teal-500/25',
    icon: '🚀', n: '03',
    title: 'Kaum Konkurrenz online',
    text: 'Die meisten Mitbewerber haben noch keinen aktiven Auftritt. Wer jetzt startet, baut einen Vorsprung, der schwer aufzuholen ist.',
  },
];
---
<section class="bg-zinc-950 py-28 px-6 overflow-hidden relative">

  <div class="absolute top-0 right-0 w-96 h-96 rounded-full
              bg-amber-400/10 blur-[90px] pointer-events-none"></div>

  <div class="max-w-5xl mx-auto">

    <p class="reveal text-brand text-xs font-bold tracking-[3px] uppercase mb-4">Die Chance</p>

    <h2 class="reveal reveal-d1 font-black text-white leading-tight
               text-4xl sm:text-5xl mb-16 max-w-2xl">
      Maler haben einen riesigen<br/>
      <span class="bg-gradient-to-r from-brand to-amber-400 bg-clip-text text-transparent">
        Online-Vorteil.
      </span><br/>
      <span class="text-zinc-600">Kaum einer nutzt ihn.</span>
    </h2>

    <div class="grid sm:grid-cols-3 gap-4">
      {cards.map((c, i) => (
        <div class={`reveal reveal-d${i + 2}
                     bg-gradient-to-br ${c.accent}
                     border rounded-2xl p-8
                     flex flex-col gap-5
                     hover:-translate-y-2 hover:scale-[1.01]
                     transition-all duration-300`}>
          <div class="flex items-start justify-between">
            <span class="text-3xl">{c.icon}</span>
            <span class="text-5xl font-black text-white/5 leading-none select-none">{c.n}</span>
          </div>
          <h3 class="text-white font-bold text-base">{c.title}</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">{c.text}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<div class="h-px bg-gradient-to-r from-transparent via-brand/40 to-transparent"></div>
