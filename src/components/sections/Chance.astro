---
---
<section class="relative py-32 px-6 bg-base overflow-hidden">

  <div class="pointer-events-none absolute bottom-0 right-0 w-[500px] h-[500px] rounded-full"
       style="background:radial-gradient(circle, rgba(251,191,36,.08) 0%, transparent 65%); filter:blur(80px)"></div>

  <div class="max-w-5xl mx-auto">

    <div class="reveal mb-4 flex items-center gap-3">
      <div class="h-px flex-1 max-w-8" style="background:linear-gradient(90deg,#f97316,transparent)"></div>
      <span class="text-orange-500 text-xs font-bold tracking-[3px] uppercase">Die Chance</span>
    </div>

    <h2 class="reveal delay-1 font-black leading-tight mb-16"
        style="font-size: clamp(2rem, 4vw, 3.2rem)">
      Maler haben einen riesigen<br />
      <span class="grad-text">Online-Vorteil.</span><br />
      <span class="text-zinc-600">Sie nutzen ihn nur selten.</span>
    </h2>

    <!-- 3-column feature grid -->
    <div class="grid sm:grid-cols-3 gap-4">
      {[
        {
          num: '01',
          icon: '📸',
          title: 'Vorher-Nachher ist King',
          text: 'Kaum eine Branche hat so starken visuellen Content. Ein Foto erzeugt mehr Vertrauen als jede Anzeige ohne Bild.',
        },
        {
          num: '02',
          icon: '📍',
          title: 'Lokale Ads, null Streuverlust',
          text: 'Mit Meta- oder Google-Ads gezielt Menschen in Freising und Umgebung ansprechen. Nur echte potenzielle Kunden.',
        },
        {
          num: '03',
          icon: '🚀',
          title: 'Kaum Konkurrenz online',
          text: 'Wer jetzt anfängt, baut einen Vorsprung auf, der schwer aufzuholen ist. Die meisten Mitbewerber schlafen noch.',
        },
      ].map((c, i) => (
        <div class:list={['glass rounded-2xl p-7 group hover:-translate-y-1.5 transition-all duration-300 reveal', `delay-${i+2}`]}>
          <div class="flex items-start justify-between mb-6">
            <span class="text-3xl">{c.icon}</span>
            <span class="text-5xl font-black text-zinc-800 group-hover:text-zinc-700 transition-colors select-none leading-none">
              {c.num}
            </span>
          </div>
          <h3 class="text-zinc-200 font-bold mb-3">{c.title}</h3>
          <p class="text-zinc-500 text-sm leading-relaxed">{c.text}</p>
        </div>
      ))}
    </div>

  </div>
</section>
