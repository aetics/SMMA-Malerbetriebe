---
---
<section class="relative min-h-screen flex flex-col justify-center
                bg-zinc-950 overflow-hidden
                px-6 pt-32 pb-24">

  <!-- Animated blobs – pure Tailwind arbitrary + animate-blob -->
  <div class="animate-blob absolute top-1/4 left-1/4 w-[480px] h-[480px]
              rounded-full bg-brand/20 blur-[100px] pointer-events-none"></div>
  <div class="animate-blob-slow absolute bottom-1/4 right-1/4 w-[380px] h-[380px]
              rounded-full bg-violet-600/15 blur-[90px] pointer-events-none
              [animation-delay:4s]"></div>
  <div class="animate-blob absolute top-2/3 left-2/3 w-[260px] h-[260px]
              rounded-full bg-amber-400/15 blur-[80px] pointer-events-none
              [animation-delay:8s]"></div>

  <!-- Dot grid -->
  <div class="absolute inset-0 pointer-events-none
              [background-image:radial-gradient(rgba(255,255,255,.04)_1px,transparent_1px)]
              [background-size:32px_32px]"></div>

  <!-- Radial vignette -->
  <div class="absolute inset-0 pointer-events-none
              bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_40%,#09090b_100%)]"></div>

  <div class="relative max-w-5xl mx-auto w-full">

    <!-- Live badge -->
    <div class="reveal inline-flex items-center gap-2.5 mb-10
                bg-brand/10 border border-brand/30 rounded-full px-4 py-2">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inset-0 rounded-full bg-brand opacity-75"></span>
        <span class="relative block h-2 w-2 rounded-full bg-brand"></span>
      </span>
      <span class="text-xs font-semibold text-zinc-400">
        Nur <strong class="text-white">1–2 Plätze</strong> frei · Freising & Umgebung
      </span>
    </div>

    <!-- Headline -->
    <h1 class="reveal reveal-d1
               text-white font-black leading-[1.03] tracking-tight
               text-5xl sm:text-6xl lg:text-7xl
               mb-7 max-w-3xl">
      Mehr gute<br/>
      Anfragen für<br/>
      deinen<br/>
      <span class="bg-gradient-to-r from-brand via-orange-400 to-amber-400
                   bg-clip-text text-transparent">
        Malerbetrieb.
      </span>
    </h1>

    <!-- Sub -->
    <p class="reveal reveal-d2
              text-zinc-400 text-lg sm:text-xl leading-relaxed
              max-w-xl mb-10">
      Social Media & lokale Werbeanzeigen –
      <span class="text-white font-semibold">vier Wochen kostenlos.</span><br/>
      Ihr zahlt nur das Werbebudget.
    </p>

    <!-- CTA buttons -->
    <div class="reveal reveal-d3 flex flex-wrap gap-4 items-center mb-20">
      <a href="#kontakt"
         class="group inline-flex items-center gap-2
                bg-gradient-to-r from-brand to-amber-400
                text-white font-bold text-base
                px-8 py-4 rounded-2xl
                shadow-[0_8px_32px_rgba(249,115,22,.45)]
                hover:shadow-[0_12px_40px_rgba(249,115,22,.6)]
                hover:-translate-y-0.5
                transition-all duration-200">
        Unverbindliches Gespräch anfragen
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      <a href="#testphase"
         class="text-zinc-500 hover:text-white text-sm
                underline underline-offset-4 transition-colors duration-150">
        Wie läuft die Testphase ab?
      </a>
    </div>

    <!-- Stat strip -->
    <div class="reveal reveal-d4
                grid grid-cols-3 max-w-sm
                rounded-2xl overflow-hidden
                border border-white/10 divide-x divide-white/10">
      {[
        { v: '4 Wochen', l: 'Testphase' },
        { v: '0 €',      l: 'Meine Arbeit' },
        { v: '1–2',      l: 'Plätze frei' },
      ].map(s => (
        <div class="bg-white/[.03] px-5 py-5 text-center">
          <p class="bg-gradient-to-r from-brand to-amber-400 bg-clip-text text-transparent
                    font-black text-xl leading-none">
            {s.v}
          </p>
          <p class="text-zinc-600 text-xs mt-1.5">{s.l}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- Section separator -->
<div class="h-px bg-gradient-to-r from-transparent via-brand/50 to-transparent"></div>
