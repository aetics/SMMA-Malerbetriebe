---
const gruende = [
  {
    icon: '📍',
    title: 'Nur Malerbetriebe in Freising & Umgebung',
    text: 'Ich arbeite nicht mit allen möglichen Branchen. Mein Fokus liegt auf Malerbetrieben in dieser Region. Deshalb kenne ich den Markt, die Konkurrenz und die Zielgruppe.',
  },
  {
    icon: '🔍',
    title: 'Die meisten Betriebe sind online noch schwach',
    text: 'Eine kurze Suche reicht: Kaum ein Malerbetrieb in der Region hat eine aktive Social-Media-Präsenz. Wer jetzt anfängt, baut einen Vorsprung auf, der lange hält.',
  },
  {
    icon: '⚡',
    title: 'Erster Mover gewinnt',
    text: 'Online-Sichtbarkeit ist kumulativ. Je früher ihr anfangt, desto mehr Bewertungen, Follower und Referenz-Content habt ihr – und desto schwerer wird es für andere, aufzuholen.',
  },
];
---
<section class="py-28 px-6 bg-surface">
  <div class="max-w-5xl mx-auto">

    <p class="text-brand text-xs font-bold tracking-[3px] uppercase mb-4">Warum Freising?</p>
    <h2 class="text-4xl sm:text-5xl font-black mb-5 leading-tight">
      Lokaler Fokus.<br />
      <span class="text-brand">Echter Vorteil.</span>
    </h2>
    <p class="text-neutral-400 text-lg max-w-xl mb-16">
      Ich betreue ausschließlich Malerbetriebe in Freising und Umgebung.
      Kein Durcheinander, kein Interessenkonflikt – nur Fokus auf eure Region.
    </p>

    <div class="grid sm:grid-cols-3 gap-5 mb-16">
      {gruende.map(g => (
        <div class="bg-card border border-border rounded-2xl p-8
                    hover:border-brand/40 hover:-translate-y-1 transition-all duration-200">
          <div class="text-3xl mb-5">{g.icon}</div>
          <h3 class="text-white font-bold text-base mb-3">{g.title}</h3>
          <p class="text-neutral-400 text-sm leading-relaxed">{g.text}</p>
        </div>
      ))}
    </div>

    <!-- Map callout -->
    <div class="bg-card border border-border rounded-2xl p-8 flex flex-col sm:flex-row gap-6 items-center">
      <div class="text-5xl">🗺️</div>
      <div>
        <h3 class="text-white font-bold text-lg mb-2">Region: Freising & Umgebung</h3>
        <p class="text-neutral-400 text-sm leading-relaxed">
          Ich arbeite mit Betrieben, die Kunden in Freising, Moosburg, Erding, Mainburg,
          Landshut oder dem Münchner Norden ansprechen wollen. Alles, was in einem realistischen
          Arbeitsradius liegt.
        </p>
      </div>
    </div>

  </div>
</section>
