---
const metrics = [
  { v:'+5–15', u:'Anfragen',   title:'Qualifizierte Leads', text:'Lokale Interessenten aus eurem Einzugsgebiet – keine Streuverluste.' },
  { v:'100%',  u:'sichtbar',   title:'Referenzen online',    text:'Vorher-Nachher-Content, der Vertrauen aufbaut, bevor jemand anruft.' },
  { v:'Top 3', u:'lokal',      title:'Klarer Vorsprung',     text:'Während andere keinen Instagram-Account haben, habt ihr Reichweite.' },
  { v:'1 S.',  u:'Reporting',  title:'Ergebnisse klar erklärt', text:'Keine Agentur-Sprache – ihr seht genau, was euer Budget gebracht hat.' },
];
---
<section class="bg-paper py-32 px-6">
  <div class="max-w-5xl mx-auto">

    <p data-reveal class="text-orange text-xs font-bold tracking-[3px] uppercase mb-4">Euer Nutzen</p>

    <h2 data-reveal data-reveal-delay="1"
        class="font-black text-ink leading-tight mb-16"
        style="font-size:clamp(2.2rem,5vw,3.8rem);">
      Was ihr nach 4 Wochen<br/>
      <span class="g-text">konkret habt.</span>
    </h2>

    <div class="grid sm:grid-cols-2 gap-5">
      {metrics.map((m,i) => (
        <div data-reveal data-reveal-delay={String(i+2)}
             class="group rounded-2xl p-8 bg-white border border-zinc-100 shadow-sm
                    hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="flex items-end gap-2 mb-4">
            <span class="g-text font-black leading-none" style="font-size:3rem; -webkit-text-fill-color:initial; background:linear-gradient(95deg,#f97316,#f59e0b); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">{m.v}</span>
            <span class="text-zinc-400 text-sm font-semibold mb-1">{m.u}</span>
          </div>
          <h3 class="text-ink font-bold mb-2">{m.title}</h3>
          <p class="text-zinc-500 text-sm leading-relaxed">{m.text}</p>
        </div>
      ))}
    </div>

  </div>
</section>
<div class="divider"></div>
