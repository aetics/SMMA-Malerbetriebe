---
const metrics = [
  { v:'+5–15', u:'Anfragen/Monat',  title:'Qualifizierte Leads',      text:'Lokale Interessenten – keine Streuverluste, kein Aufwand eurerseits.' },
  { v:'100%',  u:'sichtbar',         title:'Referenzen online',          text:'Vorher-Nachher-Content, der Vertrauen aufbaut, bevor jemand anruft.' },
  { v:'Top 3', u:'bei Google lokal', title:'Klarer Vorsprung',           text:'Während andere keinen Instagram-Account haben, habt ihr Reichweite.' },
  { v:'0 €',   u:'Mehrkosten',       title:'Komplett kostenlos testen',  text:'Nur das Werbebudget. Meine Arbeit ist in der Testphase gratis.' },
];
---
<section class="bg-zinc-50 py-28 px-6">
  <div class="max-w-5xl mx-auto">

    <p class="reveal text-brand text-xs font-bold tracking-[3px] uppercase mb-4">Euer Nutzen</p>

    <h2 class="reveal reveal-d1 font-black text-zinc-900 leading-tight text-4xl sm:text-5xl mb-14">
      Was ihr nach 4 Wochen<br/>
      <span class="bg-gradient-to-r from-brand to-amber-400 bg-clip-text text-transparent">
        konkret habt.
      </span>
    </h2>

    <div class="grid sm:grid-cols-2 gap-4">
      {metrics.map((m, i) => (
        <div class={`reveal reveal-d${i + 2}
                     group bg-white rounded-2xl p-8
                     border border-zinc-100
                     shadow-sm hover:shadow-2xl hover:shadow-zinc-200/80
                     hover:-translate-y-1.5
                     transition-all duration-300`}>
          <div class="flex items-end gap-2 mb-4">
            <span class="bg-gradient-to-r from-brand to-amber-400 bg-clip-text text-transparent
                          font-black leading-none text-5xl">
              {m.v}
            </span>
            <span class="text-zinc-400 text-sm font-semibold mb-1.5">{m.u}</span>
          </div>
          <h3 class="text-zinc-900 font-bold mb-2">{m.title}</h3>
          <p class="text-zinc-500 text-sm leading-relaxed">{m.text}</p>
          <!-- bottom accent line -->
          <div class="mt-6 h-0.5 rounded-full bg-gradient-to-r from-brand/30 to-transparent
                       scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-500"></div>
        </div>
      ))}
    </div>

  </div>
</section>

<div class="h-px bg-gradient-to-r from-transparent via-brand/40 to-transparent"></div>
