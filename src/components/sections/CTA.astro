---
// ── Personalisieren ──────────────────
const telefon   = '[Telefonnummer]';
const email     = '[E-Mail]';
const instagram = '[Instagram / Website]';
// ─────────────────────────────────────
---
<section id="kontakt" class="relative py-32 px-6 bg-base overflow-hidden">

  <!-- Large centered glow -->
  <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
    <div class="w-[700px] h-[400px] rounded-full"
         style="background:radial-gradient(ellipse, rgba(249,115,22,.14) 0%, transparent 65%); filter:blur(80px)"></div>
  </div>

  <!-- Top line -->
  <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-px"
       style="background: linear-gradient(90deg, transparent, rgba(249,115,22,.5), transparent)"></div>

  <div class="relative max-w-3xl mx-auto text-center">

    <!-- Badge -->
    <div class="reveal inline-flex items-center gap-2.5 glass rounded-full px-4 py-2 text-xs font-semibold mb-10">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
      </span>
      <span class="text-zinc-400">Noch <span class="text-zinc-200 font-bold">1–2 Plätze</span> frei</span>
    </div>

    <h2 class="reveal delay-1 font-black leading-tight mb-5"
        style="font-size: clamp(2.2rem, 5vw, 4rem)">
      Ich suche aktuell<br />
      <span class="grad-text">1–2 Malerbetriebe</span><br />
      in Freising als Testpartner.
    </h2>

    <p class="reveal delay-2 text-zinc-400 text-lg max-w-lg mx-auto mb-3">
      Wenn ihr planbar mehr Anfragen wollt und bereit seid,
      300–500 € Werbebudget einzusetzen – dann ist das eure Chance.
    </p>
    <p class="reveal delay-3 text-zinc-700 text-sm mb-12">
      Meine Arbeit ist kostenlos. Kein Vertrag. Keine Mindestlaufzeit.
    </p>

    <!-- Contact cards -->
    <div class="reveal delay-4 grid sm:grid-cols-3 gap-3 mb-10">
      {[
        { icon: '📞', label: 'Telefon / WhatsApp', val: telefon,   href: `tel:${telefon}` },
        { icon: '✉️',  label: 'E-Mail',             val: email,     href: `mailto:${email}` },
        { icon: '📷',  label: 'Instagram / Web',    val: instagram, href: '#' },
      ].map(k => (
        <a href={k.href}
           class="glass rounded-2xl p-6 text-left group hover:-translate-y-1 transition-all duration-300">
          <div class="text-2xl mb-3">{k.icon}</div>
          <p class="text-zinc-600 text-xs font-semibold uppercase tracking-wider mb-1">{k.label}</p>
          <p class="text-zinc-200 font-bold text-sm group-hover:text-orange-400 transition-colors">{k.val}</p>
        </a>
      ))}
    </div>

    <!-- Main CTA -->
    <div class="reveal delay-5">
      <a href={`mailto:${email}?subject=Testpartner%20Anfrage&body=Hallo%2C%0A%0Aich%20interessiere%20mich%20als%20Testpartner.%0A%0AMein%20Betrieb%3A%20%0AStadt%3A%20%0ATelefon%3A%20`}
         class="group inline-flex items-center gap-3 bg-gradient-brand text-white font-black
                text-base px-9 py-4 rounded-xl
                shadow-[0_0_40px_rgba(249,115,22,.35)] hover:shadow-[0_0_60px_rgba(249,115,22,.5)]
                hover:-translate-y-0.5 transition-all duration-200 mb-6">
        Jetzt unverbindlich melden
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      <p class="text-zinc-700 text-sm">
        Kein Verkaufsgespräch. Ich erkläre kurz, was ich machen würde – ihr entscheidet.
      </p>
    </div>

  </div>
</section>

<footer class="relative bg-surface border-t border-white/5 py-8 px-6 text-center">
  <p class="text-zinc-700 text-sm">
    Social-Media-Marketing für Malerbetriebe in Freising & Umgebung ·
    <a href={`mailto:${email}`} class="text-orange-500/70 hover:text-orange-400 transition-colors">{email}</a>
  </p>
</footer>
