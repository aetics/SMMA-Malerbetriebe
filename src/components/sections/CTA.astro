---
// ── Hier personalisieren ──────────────
const telefon   = '[Telefonnummer]';
const email     = '[E-Mail]';
const instagram = '[Instagram / Website]';
// ─────────────────────────────────────
---

<section id="kontakt"
         class="relative overflow-hidden
                bg-gradient-to-br from-brand-dark via-brand to-amber-400">

  <!-- Dot overlay -->
  <div class="absolute inset-0 pointer-events-none
              [background-image:radial-gradient(rgba(255,255,255,.07)_1px,transparent_1px)]
              [background-size:28px_28px]"></div>

  <!-- Top + bottom shadow -->
  <div class="absolute inset-0 pointer-events-none
              bg-gradient-to-b from-black/20 via-transparent to-black/25"></div>

  <div class="relative max-w-5xl mx-auto px-6 py-32 text-center">

    <!-- Badge -->
    <div class="reveal inline-flex items-center gap-2.5 mb-10
                bg-white/15 border border-white/25 rounded-full px-4 py-2
                backdrop-blur-sm">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inset-0 rounded-full bg-white opacity-75"></span>
        <span class="relative block h-2 w-2 rounded-full bg-white"></span>
      </span>
      <span class="text-white text-xs font-semibold">Noch 1–2 Plätze frei</span>
    </div>

    <!-- Headline -->
    <h2 class="reveal reveal-d1
               font-black text-white leading-tight
               text-4xl sm:text-5xl lg:text-6xl
               mb-5"
        style="text-shadow: 0 2px 20px rgba(0,0,0,.15)">
      Ich suche aktuell<br/>
      1–2 Malerbetriebe<br/>
      in Freising.
    </h2>

    <p class="reveal reveal-d2 text-orange-100 text-lg max-w-lg mx-auto mb-3 leading-relaxed">
      Bereit für planbare Anfragen aus der Region?<br/>
      Meldet euch – unverbindlich und ohne Druck.
    </p>
    <p class="reveal reveal-d3 text-orange-200/60 text-sm mb-12">
      Meine Arbeit kostenlos · Kein Vertrag · Keine Mindestlaufzeit
    </p>

    <!-- Contact cards -->
    <div class="reveal reveal-d4 grid sm:grid-cols-3 gap-4 max-w-2xl mx-auto mb-10">
      {[
        { icon:'📞', label:'Telefon / WhatsApp', val: telefon,   href:`tel:${telefon}` },
        { icon:'✉️',  label:'E-Mail',             val: email,     href:`mailto:${email}` },
        { icon:'📷',  label:'Instagram / Web',    val: instagram, href:'#' },
      ].map(k => (
        <a href={k.href}
           class="group rounded-2xl p-5 text-left
                  bg-white/12 border border-white/20 backdrop-blur-sm
                  hover:bg-white/20 hover:-translate-y-1
                  transition-all duration-200">
          <div class="text-2xl mb-3">{k.icon}</div>
          <p class="text-white/60 text-xs font-semibold uppercase tracking-wider mb-1">{k.label}</p>
          <p class="text-white font-bold text-sm">{k.val}</p>
        </a>
      ))}
    </div>

    <!-- CTA -->
    <div class="reveal reveal-d5">
      <a href={`mailto:${email}?subject=Testpartner%20Anfrage&body=Hallo,%0A%0Aich%20interessiere%20mich%20als%20Testpartner.%0A%0AMein%20Betrieb:%20%0AStadt:%20%0ATelefon:%20`}
         class="group inline-flex items-center gap-3
                bg-white text-brand font-black text-base
                px-10 py-5 rounded-2xl
                shadow-[0_8px_40px_rgba(0,0,0,.25)]
                hover:shadow-[0_12px_50px_rgba(0,0,0,.35)]
                hover:-translate-y-0.5
                transition-all duration-200 mb-5">
        Jetzt unverbindlich melden
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform"
             fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      <p class="text-orange-200/50 text-sm">
        Kein Verkaufsgespräch. Nur ehrliche Beratung.
      </p>
    </div>

  </div>
</section>

<footer class="bg-zinc-950 border-t border-white/5 py-8 px-6 text-center">
  <p class="text-zinc-700 text-sm">
    Social-Media-Marketing für Malerbetriebe · Freising & Umgebung ·
    <a href={`mailto:${email}`} class="text-brand/60 hover:text-brand transition-colors">{email}</a>
  </p>
</footer>
