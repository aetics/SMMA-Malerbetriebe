---
const cards = [
  {
    icon: '🔍',
    title: 'Unsichtbar bei Google',
    text: 'Wer „Maler in [Stadt]" sucht, findet dich nicht. Der Auftrag geht an jemand anderen – nicht weil der besser ist, sondern weil er sichtbar ist.',
  },
  {
    icon: '📱',
    title: 'Social Media liegt brach',
    text: 'Keine Zeit für Posts, keine Strategie. Dabei entscheiden Kunden heute über Instagram & Co, bevor sie überhaupt anrufen.',
  },
  {
    icon: '⭐',
    title: 'Zu wenig Bewertungen',
    text: 'Zufriedene Kunden sagen nichts online. Dabei liest fast jeder Bewertungen, bevor er einen Handwerker beauftragt.',
  },
  {
    icon: '💬',
    title: 'Anfragen nur über Empfehlung',
    text: 'Empfehlungen sind wertvoll – reichen aber nicht aus, um planbar zu wachsen. Ein stabiler Online-Kanal fehlt.',
  },
  {
    icon: '🕐',
    title: 'Keine Zeit für Marketing',
    text: 'Nach einem langen Arbeitstag bleibt kein Kopf mehr für Social Media oder Google-Profile. Das ist absolut verständlich.',
  },
  {
    icon: '💸',
    title: 'Preiskampf mangels Profil',
    text: 'Wer online nicht als Experte wahrgenommen wird, muss preislich mithalten. Starke Präsenz schützt deinen Stundensatz.',
  },
];
---
<section id="schmerzen" class="bg-white py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <p class="text-accent text-xs font-bold tracking-[3px] uppercase mb-3">Das kennt fast jeder Betrieb</p>
    <h2 class="text-3xl font-extrabold mb-4">Warum gute Handwerker trotzdem<br />keine Anfragen bekommen</h2>
    <p class="text-gray-500 max-w-lg mb-14">
      Die Qualität deiner Arbeit spricht für sich – aber das reicht nicht, wenn dich online niemand findet.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {cards.map(c => (
        <div class="bg-gray-50 border-l-4 border-danger rounded-xl p-7 hover:-translate-y-1 transition-transform">
          <div class="text-3xl mb-3">{c.icon}</div>
          <h3 class="text-danger font-bold text-sm mb-2">{c.title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{c.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
