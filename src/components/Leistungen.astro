---
const cards = [
  {
    icon: '📍',
    title: 'Google Business Profil',
    desc: 'Dein wichtigstes lokales Aushängeschild – vollständig optimiert.',
    items: [
      'Profil vervollständigen & optimieren',
      'Fotos hochladen & beschriften',
      'Öffnungszeiten, Leistungen, Beschreibung',
      'Auf Bewertungen antworten',
    ],
  },
  {
    icon: '📸',
    title: 'Instagram & Facebook',
    desc: 'Professionelle Präsenz auf Social Media – regelmäßig und authentisch.',
    items: [
      'Profil einrichten / auffrischen',
      '8–12 Beiträge im Monat',
      'Vorher-Nachher-Content',
      'Stories & kurze Reels',
    ],
  },
  {
    icon: '⭐',
    title: 'Bewertungen aufbauen',
    desc: 'Zufriedene Kunden aktiv um Bewertungen bitten – mit System.',
    items: [
      'Anschreiben an Bestandskunden',
      'Einfacher QR-Code für Bewertungen',
      'Ziel: +5 bis +10 neue Rezensionen',
    ],
  },
  {
    icon: '🌐',
    title: 'Website-Check & Optimierung',
    desc: 'Ich schaue mir deine bestehende Website an und bessere direkt aus.',
    items: [
      'Klarer Call-to-Action',
      'Kontakt & Telefon prominent',
      'Ladezeit & Mobiloptimierung prüfen',
      'Lokale Keywords einbauen',
    ],
  },
  {
    icon: '📊',
    title: 'Auswertung am Monatsende',
    desc: 'Du bekommst einen klaren Überblick, was erreicht wurde.',
    items: [
      'Reichweite & Profilaufrufe',
      'Neue Bewertungen & Sterne',
      'Follower-Entwicklung',
      'Handlungsempfehlungen',
    ],
  },
  {
    icon: '💬',
    title: 'Direkte Kommunikation',
    desc: 'Kein Ticketsystem, kein Callcenter. Ich bin direkt erreichbar.',
    items: [
      'WhatsApp oder E-Mail',
      'Kurze Abstimmung zu Beginn',
      'Kaum Zeitaufwand für dich',
    ],
  },
];
---
<section
  id="leistungen"
  class="py-24 px-6"
  style="background: linear-gradient(140deg, #1a1a2e 0%, #16213e 100%)"
>
  <div class="max-w-5xl mx-auto">
    <p class="text-accent text-xs font-bold tracking-[3px] uppercase mb-3">Was ich für dich tue</p>
    <h2 class="text-3xl font-extrabold text-white mb-4">
      Meine Leistungen – <span class="text-accent">alles inklusive</span>
    </h2>
    <p class="text-gray-400 max-w-lg mb-14">
      Einen Monat lang übernehme ich deinen kompletten Online-Auftritt. Kein Aufwand für dich, keine Kosten.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {cards.map(c => (
        <div class="bg-white/5 border border-white/10 rounded-xl p-7 hover:bg-white/10 transition-colors">
          <div class="text-3xl mb-4">{c.icon}</div>
          <h3 class="text-white font-bold text-base mb-2">{c.title}</h3>
          <p class="text-gray-400 text-sm mb-4">{c.desc}</p>
          <ul class="space-y-1">
            {c.items.map(item => (
              <li class="text-gray-400 text-xs border-b border-white/5 pb-1">
                <span class="text-accent font-bold">→ </span>{item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
