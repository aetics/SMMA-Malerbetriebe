<div class="h-px bg-gradient-to-r from-transparent via-orange-500/20 to-transparent"></div>


<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     ABLAUF  (timeline)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
<section id="ablauf" class="bg-white py-28 px-6">
  <div class="max-w-5xl mx-auto">

    <div class="reveal inline-flex items-center gap-2 bg-orange-50 border border-orange-200
                text-orange-600 text-xs font-bold uppercase tracking-[2.5px]
                px-3.5 py-1.5 rounded-full mb-6">
      Ablauf & Zusammenarbeit
    </div>

    <h2 class="reveal reveal-d1 font-black text-zinc-900 leading-tight
               text-4xl sm:text-5xl mb-4 max-w-2xl">
      Schritt für Schritt –<br/>
      <span class="text-zinc-300">unkompliziert.</span>
    </h2>
    <p class="reveal reveal-d2 text-zinc-500 text-lg max-w-xl mb-16">
      Kein langer Vorlauf, kein Papierkram. In wenigen Tagen seid ihr startklar.
    </p>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-[26px] sm:left-[31px] top-6 bottom-6
                  w-px bg-gradient-to-b from-orange-200 via-orange-300 to-orange-100">
      </div>

      <div class="flex flex-col gap-6">
        {schritte.map((s, i) => (
          <div class={`reveal reveal-d${i + 1}
                       group relative flex gap-5 sm:gap-7 items-start`}>

            <!-- Circle node on the line -->
            <div class="shrink-0 relative z-10
                        w-[52px] h-[52px] sm:w-[62px] sm:h-[62px] rounded-full
                        bg-white border-2 border-orange-300
                        flex items-center justify-center
                        group-hover:border-orange-500 group-hover:shadow-[0_0_20px_rgba(249,115,22,.3)]
                        transition-all duration-300">
              <span class="text-orange-500 font-black text-sm sm:text-base">{s.nr}</span>
            </div>

            <!-- Content card -->
            <div class="flex-1 bg-zinc-50 hover:bg-white
                        border border-zinc-100 hover:border-orange-200
                        hover:shadow-[0_8px_40px_rgba(249,115,22,.07)]
                        rounded-2xl p-6 sm:p-7 mb-0
                        hover:-translate-y-0.5 transition-all duration-300">
              <div class="flex flex-wrap items-center gap-3 mb-2">
