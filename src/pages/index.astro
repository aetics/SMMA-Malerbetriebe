---
import Layout        from '../layouts/Layout.astro';
import NavBar        from '../components/NavBar.astro';
import Hero          from '../components/sections/Hero.astro';
import Problem       from '../components/sections/Problem.astro';
import Chance        from '../components/sections/Chance.astro';
import Loesung       from '../components/sections/Loesung.astro';
import Testphase     from '../components/sections/Testphase.astro';
import Nutzen        from '../components/sections/Nutzen.astro';
import WarumFreising from '../components/sections/WarumFreising.astro';
import Ablauf        from '../components/sections/Ablauf.astro';
import CTA           from '../components/sections/CTA.astro';
---
<Layout>
  <NavBar />
  <main class="pt-16">
    <Hero />
    <div id="problem"><Problem /></div>
    <Chance />
    <Loesung />
    <Testphase />
    <Nutzen />
    <WarumFreising />
    <Ablauf />
    <CTA />
  </main>
</Layout>
