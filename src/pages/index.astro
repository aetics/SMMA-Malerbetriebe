---

<Layout title="Mehr Anfragen für Malerbetriebe in Freising">

<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     NAVIGATION  (Mobile-First mit Hamburger)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
<header class="fixed top-0 inset-x-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/70">
  <div class="max-w-6xl mx-auto px-4 md:px-6">

    <!-- Main bar -->
    <div class="flex items-center justify-between h-14 md:h-16">

      <a href="#" class="font-semibold text-slate-900 tracking-tight text-sm shrink-0">
        SMMA <span class="text-indigo-600 font-bold">Malerbetriebe</span>
      </a>

      <!-- Desktop links -->
      <nav class="hidden md:flex items-center gap-6 lg:gap-8">
        {[['#problem','Herausforderungen'],['#fachkraefte','Fachkräfte'],['#loesung','Leistungen'],['#testphase','Testphase'],['#ablauf','Ablauf']].map(([h,l]) => (
          <a href={h} class="text-slate-500 hover:text-slate-900 text-sm transition-colors duration-200">{l}</a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <!-- Desktop CTA -->
        <a href="#kontakt"
           class="hidden md:inline-flex items-center gap-1.5
                  bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium
                  px-4 py-2.5 rounded-xl transition-colors duration-200">
          Gespräch anfragen
        </a>

        <!-- Hamburger (mobile only) -->
        <button id="menu-btn" aria-label="Menü öffnen"
                class="md:hidden flex flex-col justify-center items-center w-9 h-9
                       rounded-lg hover:bg-slate-100 transition-colors duration-200 gap-1.5">
          <span id="bar1" class="block w-5 h-0.5 bg-slate-700 transition-all duration-300"></span>
          <span id="bar2" class="block w-5 h-0.5 bg-slate-700 transition-all duration-300"></span>
          <span id="bar3" class="block w-5 h-0.5 bg-slate-700 transition-all duration-300"></span>
        </button>
      </div>
    </div>

    <!-- Mobile dropdown -->
    <div id="mobile-menu"
         class="md:hidden overflow-hidden max-h-0 transition-all duration-300 ease-in-out">
      <nav class="flex flex-col gap-1 py-3 border-t border-slate-100">
        {[['#problem','Herausforderungen'],['#fachkraefte','Fachkräfte'],['#loesung','Leistungen'],['#testphase','Testphase'],['#ablauf','Ablauf'],['#kontakt','Kontakt']].map(([h,l]) => (
          <a href={h}
             class="mobile-link text-slate-600 hover:text-indigo-600 hover:bg-indigo-50
                    text-sm font-medium px-3 py-2.5 rounded-lg transition-colors duration-200">
            {l}
          </a>
        ))}
        <div class="pt-2 mt-1 border-t border-slate-100">
          <a href={mailto}
             class="flex items-center justify-center gap-2
                    bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold
                    w-full px-4 py-3 rounded-xl transition-colors duration-200">
            Jetzt kostenlos melden
          </a>
        </div>
      </nav>
    </div>

  </div>
</header>

<script>
  const btn   = document.getElementById('menu-btn')!;
  const menu  = document.getElementById('mobile-menu')!;
  const bar1  = document.getElementById('bar1')!;
  const bar2  = document.getElementById('bar2')!;
  const bar3  = document.getElementById('bar3')!;
  let open = false;

  btn.addEventListener('click', () => {
    open = !open;
    menu.style.maxHeight = open ? menu.scrollHeight + 'px' : '0';
    bar1.style.transform  = open ? 'translateY(8px) rotate(45deg)' : '';
    bar2.style.opacity    = open ? '0' : '1';
    bar3.style.transform  = open ? 'translateY(-8px) rotate(-45deg)' : '';
  });

  document.querySelectorAll('.mobile-link').forEach(l =>
    l.addEventListener('click', () => {
      open = false;
      menu.style.maxHeight = '0';
      bar1.style.transform = bar3.style.transform = '';
      bar2.style.opacity = '1';
    })
  );
</script>


<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     HERO
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
<section class="relative bg-white overflow-hidden
                pt-24 pb-12 px-4
                md:pt-32 md:pb-20 md:px-6
                lg:pt-36 lg:pb-24">

  <!-- Subtle background shapes (visible on all sizes) -->
  <div class="pointer-events-none absolute top-0 right-0 w-[600px] h-[600px]
              bg-indigo-50 rounded-full opacity-50 -translate-y-1/2 translate-x-1/3"></div>
  <div class="pointer-events-none absolute bottom-0 left-0 w-80 h-80
              bg-slate-100 rounded-full opacity-60 translate-y-1/2 -translate-x-1/4"></div>
  <!-- Dot grid decoration -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.035]"
       style="background-image:radial-gradient(circle, #6366f1 1px, transparent 1px); background-size: 28px 28px;"></div>

  <div class="relative max-w-6xl mx-auto">
    <div class="flex flex-col lg:flex-row lg:items-center lg:gap-12 xl:gap-16">

      <!-- ── Left: text ── -->
      <div class="flex-1 lg:max-w-xl xl:max-w-2xl">

        <!-- Eyebrow -->
        <div class="reveal inline-flex items-center gap-2 bg-indigo-50 text-indigo-700
                    text-xs font-semibold px-3 py-1.5 rounded-full mb-6 border border-indigo-100">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse shrink-0"></span>
          Noch 1–2 Plätze in Freising verfügbar
        </div>

        <!-- Headline -->
        <h1 class="reveal reveal-d1 text-slate-900 font-bold tracking-tight leading-[1.08]
                   text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl mb-5 md:mb-6">
          Mehr planbare<br/>
          Anfragen für<br/>
          deinen<br/>
          <span class="text-indigo-600">Malerbetrieb.</span>
        </h1>

        <!-- Subtext -->
        <p class="reveal reveal-d2 text-slate-600 text-base md:text-lg
                  leading-relaxed max-w-lg mb-8 md:mb-10">
          Social Media &amp; lokale Werbeanzeigen speziell für Maler –
          professionell umgesetzt,
          <strong class="text-slate-800 font-semibold">4 Wochen lang ohne Agenturkosten</strong>.
          Ihr zahlt nur das Werbebudget.
        </p>

        <!-- CTAs -->
        <div class="reveal reveal-d3 flex flex-col sm:flex-row gap-3 sm:gap-4 mb-10 md:mb-14">
          <a href="#kontakt"
             class="w-full sm:w-auto inline-flex items-center justify-center gap-2
                    bg-indigo-600 hover:bg-indigo-700
                    text-white font-semibold text-base
                    px-6 py-3.5 md:px-8 md:py-4 rounded-xl
                    shadow-sm hover:shadow-md transition duration-200">
            Kostenloses Erstgespräch anfragen
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
            </svg>
          </a>
          <a href="#testphase"
             class="w-full sm:w-auto inline-flex items-center justify-center
                    text-slate-600 hover:text-slate-900 text-base font-medium
                    border border-slate-200 hover:border-slate-300
                    px-6 py-3.5 rounded-xl transition duration-200 bg-slate-50 hover:bg-slate-100">
            Wie läuft die Testphase ab?
          </a>
        </div>

        <!-- Metrics strip -->
        <div class="reveal reveal-d4 grid grid-cols-3
                    border border-slate-200/60 rounded-2xl divide-x divide-slate-200/60
                    shadow-sm overflow-hidden max-w-sm md:max-w-md">
          {[
            { v: '4 Wochen', l: 'Testphase' },
            { v: '0 €',      l: 'Agenturkosten' },
            { v: '1–2',      l: 'Plätze frei' },
          ].map(s => (
            <div class="bg-slate-50/80 py-4 md:py-5 px-2 md:px-4 text-center">
              <p class="text-indigo-600 font-bold text-lg md:text-2xl leading-none tracking-tight">{s.v}</p>
              <p class="text-slate-400 text-xs mt-1.5 md:mt-2 font-medium">{s.l}</p>
            </div>
          ))}
        </div>

      </div>

      <!-- ── Right: image composition (visible on all sizes) ── -->
      <div class="reveal reveal-d2 flex flex-1 items-center justify-center lg:justify-end mt-8 md:mt-10 lg:mt-0">
        <div class="relative w-full max-w-sm sm:max-w-[440px] xl:max-w-[460px] sm:pt-6 sm:pb-10">

          <!-- Decorative blob behind image -->
          <div class="absolute -top-8 -right-8 w-56 h-56 bg-indigo-100 rounded-full opacity-70 blur-2xl"></div>
          <div class="absolute -bottom-6 -left-6 w-36 h-36 bg-slate-200 rounded-full opacity-60 blur-xl"></div>

          <!-- Main photo -->
          <div class="relative rounded-3xl overflow-hidden shadow-2xl shadow-slate-300/60
                      aspect-video sm:aspect-[4/3] lg:aspect-[4/5] border border-slate-200/60">
