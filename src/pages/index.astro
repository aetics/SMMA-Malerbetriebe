                  shadow-sm hover:shadow-md transition duration-300">
        <div class="w-9 h-9 md:w-10 md:h-10 rounded-xl bg-indigo-50 border border-indigo-100
                    flex items-center justify-center text-indigo-600 mb-4 md:mb-6">
          <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607z"/>
