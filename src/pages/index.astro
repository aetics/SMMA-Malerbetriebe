---
// ─────────────────────────────────────────
// Personalisierung – nur diese 3 Zeilen
const TELEFON   = '[Telefonnummer]';
const EMAIL     = '[E-Mail-Adresse]';
const INSTAGRAM = '[Instagram / Website]';
// ─────────────────────────────────────────
import Layout from '../layouts/Layout.astro';

const mailto = `mailto:${EMAIL}?subject=Testpartner%20Anfrage&body=Hallo%2C%0A%0Aich%20interessiere%20mich%20als%20Testpartner.%0A%0AMein%20Betrieb%3A%20%0AStadt%2FPLZ%3A%20%0ATelefon%3A%20`;

const probleme = [
  { icon: '📵', titel: 'Online kaum sichtbar',       text: 'Kein aktiver Social-Media-Auftritt, eine veraltete Website oder nur ein Branchenbuch-Eintrag. Wer online sucht, findet euch schlicht nicht.' },
  { icon: '📞', titel: 'Abhängig von Empfehlungen',  text: 'Empfehlungen sind wertvoll – aber sie lassen sich nicht planen. In ruhigen Phasen fehlen Anfragen, obwohl die Kapazität da wäre.' },
  { icon: '🏆', titel: 'Gute Arbeit bleibt unsichtbar', text: 'Ihr macht tolle Projekte – aber kaum jemand sieht sie. Kein Vorher-Nachher, keine Bewertungen, keine Reichweite.' },
  { icon: '🕐', titel: 'Keine Zeit fürs Marketing',  text: 'Nach einem langen Arbeitstag auf der Baustelle bleibt keine Energie für Posts, Anzeigen oder Google-Profile.' },
];

const leistungen = [
  { nr: '01', icon: '📸', titel: 'Social Media Betreuung',  text: 'Ich übernehme Instagram und Facebook vollständig – Profil, Posts, Vorher-Nachher-Content, Stories und Reels.', tags: ['Instagram', 'Facebook', 'Reels'] },
  { nr: '02', icon: '🎯', titel: 'Lokale Werbeanzeigen',    text: 'Gezielte Meta- und Google-Anzeigen für Freising und Umgebung. Kein Streuverlust, nur qualifizierte Anfragen.', tags: ['Meta Ads', 'Google Ads'] },
  { nr: '03', icon: '⚡', titel: 'Einfache Lead-Strecke',   text: 'Klare Seite mit Formular oder direktem WhatsApp-Link. Anfragen kommen direkt bei euch an – ohne Umwege.', tags: ['Landing Page', 'WhatsApp'] },
  { nr: '04', icon: '📊', titel: 'Klares Reporting',        text: 'Nicht Likes, sondern echte Anfragen. Jeden Monat: Wie viele? Woher? Was haben sie gekostet?', tags: ['Leads', 'Reporting'] },
];

const wochen = [
  { w: '01', label: 'Woche 1', titel: 'Setup & Strategie',  punkte: ['Erstgespräch & Zieldefinition', 'Audit des aktuellen Auftritts', 'Profile optimieren', 'Content-Plan erstellen'] },
  { w: '02', label: 'Woche 2', titel: 'Start & erste Ads',  punkte: ['Erste Posts veröffentlichen', 'Werbeanzeige schalten', 'Lead-Strecke aktivieren', 'Daten beobachten'], hot: true },
  { w: '03', label: 'Woche 3', titel: 'Optimieren',         punkte: ['Anzeigen anpassen', 'Content weiterführen', 'Anfragen tracken', 'Zwischenbilanz'] },
  { w: '04', label: 'Woche 4', titel: 'Auswertung',         punkte: ['Gesamtergebnis auswerten', 'Kosten pro Anfrage', 'Qualität besprechen', 'Gemeinsam entscheiden'] },
];

const nutzen = [
  { wert: '+5–15',  einheit: 'Anfragen/Monat',  titel: 'Qualifizierte Leads',          text: 'Aus eurer Region, ohne Streuverlust, kein Aufwand eurerseits.' },
  { wert: '0 €',   einheit: 'Mehrkosten',        titel: 'Meine Arbeit ist gratis',      text: 'Ihr zahlt nur das Werbebudget – meine Zeit und Strategie nicht.' },
  { wert: '100%',  einheit: 'Transparenz',       titel: 'Klares Reporting',             text: 'Kein Fachjargon. Verständliche Zahlen, jeden Monat.' },
  { wert: 'Top 3', einheit: 'lokal bei Google', titel: 'Vorsprung vor Mitbewerbern',   text: 'Die meisten Konkurrenten sind noch gar nicht online aktiv.' },
];

const schritte = [
  { nr: '01', titel: 'Kurzes Erstgespräch',   dauer: '~30 Min.',  text: 'Telefon oder Video-Call. Ich lerne euren Betrieb kennen und erkläre, wie ich vorgehe.' },
  { nr: '02', titel: 'Check des Auftritts',   dauer: '1–2 Tage', text: 'Website, Google-Profil und Social Media. Ich sage ehrlich, was ich sehe und wo die größten Chancen liegen.' },
  { nr: '03', titel: 'Testphase startet',      dauer: '4 Wochen', text: 'Klares Startdatum, klare Ziele. Regelmäßige Updates – ohne Fachchinesisch.' },
  { nr: '04', titel: 'Gemeinsame Auswertung', dauer: 'Danach',   text: 'Ergebnisse, Kosten pro Anfrage, Qualität. Dann entscheidet ihr, ob und wie es weitergeht.' },
];
---

<Layout title="Mehr Anfragen für Malerbetriebe in Freising | SMMA">

<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     NAV
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
<header class="fixed top-0 inset-x-0 z-50 flex justify-center pt-4 px-4">
  <nav class="w-full max-w-5xl flex items-center justify-between
              px-5 h-[52px] rounded-2xl
              bg-zinc-950/90 backdrop-blur-xl
              border border-white/[0.08]
              shadow-[0_4px_24px_rgba(0,0,0,.4)]">

    <span class="font-black text-sm tracking-tight text-white">
      SMMA<span class="text-orange-500">.</span>
    </span>

    <div class="hidden md:flex items-center gap-7">
      {[['#problem','Problem'],['#loesung','Leistungen'],['#testphase','Testphase'],['#ablauf','Ablauf']].map(([h,l]) => (
        <a href={h} class="text-zinc-500 hover:text-zinc-200 text-xs font-medium transition-colors duration-150">{l}</a>
      ))}
    </div>

    <a href="#kontakt"
       class="group flex items-center gap-1.5
              bg-orange-500 hover:bg-orange-400
              text-white text-xs font-bold
              px-4 py-2 rounded-xl
              transition-all duration-150
              shadow-[0_2px_12px_rgba(249,115,22,.4)]">
      Gespräch anfragen
      <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </a>
  </nav>
</header>


<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     HERO
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
<section class="relative bg-zinc-950 min-h-screen flex flex-col justify-center overflow-hidden px-6 pt-24 pb-0">

  <!-- Ambient glow -->
  <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-[900px] h-[600px]
              bg-[radial-gradient(ellipse_at_center,rgba(249,115,22,.13)_0%,transparent_70%)]"></div>
  <div class="pointer-events-none absolute bottom-0 right-0 w-[500px] h-[500px]
              bg-[radial-gradient(ellipse_at_bottom_right,rgba(251,146,60,.07)_0%,transparent_65%)]"></div>

  <!-- Grid overlay -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.03]
              [background-image:linear-gradient(rgba(255,255,255,.6)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.6)_1px,transparent_1px)]
              [background-size:60px_60px]"></div>

  <div class="relative max-w-5xl mx-auto w-full flex flex-col items-center text-center py-16">

    <!-- Badge -->
    <div class="reveal inline-flex items-center gap-2
                bg-orange-500/10 border border-orange-500/25 rounded-full
                px-4 py-1.5 mb-8">
      <span class="relative flex h-1.5 w-1.5">
        <span class="absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75 animate-ping"></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-orange-500"></span>
      </span>
      <span class="text-orange-400 text-xs font-semibold tracking-wide">
        Speziell für Malerbetriebe in Freising &amp; Umgebung
      </span>
    </div>

    <!-- Headline -->
    <h1 class="reveal reveal-d1 text-white font-black leading-[1.04] tracking-tight
               text-5xl sm:text-6xl lg:text-7xl mb-6 max-w-4xl">
      Mehr gute Anfragen<br/>
      für deinen<br/>
      <span class="bg-gradient-to-r from-orange-400 via-orange-500 to-amber-400
                   bg-clip-text text-transparent">
        Malerbetrieb.
      </span>
    </h1>

    <!-- Sub -->
    <p class="reveal reveal-d2 text-zinc-400 text-lg sm:text-xl leading-relaxed max-w-xl mb-10">
      Social Media &amp; Online-Werbung speziell für Maler –<br/>
      <span class="text-white font-semibold">4 Wochen lang komplett kostenlos.</span>
    </p>

    <!-- CTAs -->
    <div class="reveal reveal-d3 flex flex-wrap justify-center gap-4 mb-20">
      <a href="#kontakt"
         class="group inline-flex items-center gap-2
                bg-orange-500 hover:bg-orange-400
                text-white font-bold text-base
                px-8 py-4 rounded-2xl
                shadow-[0_8px_32px_rgba(249,115,22,.45)]
                hover:shadow-[0_12px_40px_rgba(249,115,22,.6)]
                hover:-translate-y-0.5 transition-all duration-200">
        Jetzt kostenlos starten
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      <a href="#testphase"
         class="inline-flex items-center gap-2 text-zinc-500 hover:text-zinc-300 text-sm
                border border-white/10 hover:border-white/20
                px-6 py-4 rounded-2xl transition-all duration-200 bg-white/[.03]">
        Wie funktioniert es?
      </a>
    </div>

    <!-- Stats strip -->
    <div class="reveal reveal-d4 w-full max-w-2xl grid grid-cols-3
                border border-white/[.07] rounded-2xl overflow-hidden
                bg-white/[.025] backdrop-blur-sm divide-x divide-white/[.07]">
      {[
        { v: '4 Wochen', l: 'Kostenlose Testphase' },
        { v: '1–2',      l: 'Plätze noch frei' },
        { v: '0 €',      l: 'Meine Arbeitskosten' },
      ].map(s => (
        <div class="py-5 text-center">
          <p class="text-orange-400 font-black text-2xl leading-none">{s.v}</p>
          <p class="text-zinc-600 text-xs mt-2">{s.l}</p>
        </div>
      ))}
    </div>

  </div>

  <!-- Scroll cue -->
  <div class="relative flex justify-center pb-10">
    <div class="flex flex-col items-center gap-1.5 text-zinc-700">
      <span class="text-[10px] font-medium uppercase tracking-widest">Mehr erfahren</span>
      <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </div>

</section>

<!-- Section divider -->
<div class="h-px bg-gradient-to-r from-transparent via-orange-500/30 to-transparent"></div>


<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     PROBLEM
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
<section id="problem" class="bg-white py-28 px-6">
  <div class="max-w-5xl mx-auto">

    <div class="reveal inline-flex items-center gap-2 bg-orange-50 border border-orange-200
                text-orange-600 text-xs font-bold uppercase tracking-[2.5px]
                px-3.5 py-1.5 rounded-full mb-6">
      Das Problem
    </div>

    <h2 class="reveal reveal-d1 font-black text-zinc-900 leading-tight
               text-4xl sm:text-5xl mb-4 max-w-2xl">
      Gute Arbeit reicht heute<br/>nicht mehr allein.
    </h2>
    <p class="reveal reveal-d2 text-zinc-500 text-lg max-w-xl mb-14">
      Die meisten Malerbetriebe in der Region sind online kaum sichtbar –
      das ist ein Problem und gleichzeitig eure größte Chance.
    </p>

    <div class="grid sm:grid-cols-2 gap-4">
      {probleme.map((p, i) => (
        <div class={`reveal reveal-d${i + 1} group
                     flex gap-5 items-start
                     bg-zinc-50 hover:bg-white
                     border border-zinc-100 hover:border-orange-200
                     hover:shadow-[0_8px_40px_rgba(249,115,22,.08)]
                     rounded-2xl p-7
                     hover:-translate-y-1 transition-all duration-300`}>
          <div class="shrink-0 w-12 h-12 rounded-xl
                      bg-white border border-zinc-100 shadow-sm
                      flex items-center justify-center text-2xl
                      group-hover:border-orange-100 group-hover:shadow-orange-50/80
                      transition-all duration-300">
            {p.icon}
          </div>
          <div>
            <h3 class="text-zinc-900 font-bold text-base mb-2">{p.titel}</h3>
            <p class="text-zinc-500 text-sm leading-relaxed">{p.text}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Quote -->
    <div class="reveal reveal-d5 mt-6 flex gap-4 items-start
                bg-gradient-to-r from-orange-50 to-amber-50
                border border-orange-100 rounded-2xl px-7 py-6">
      <div class="shrink-0 text-3xl text-orange-300 font-serif leading-none select-none">"</div>
      <p class="text-zinc-700 text-base leading-relaxed">
        In Freising findet man bei Google meistens nicht den besten Maler –
        sondern den, der
        <strong class="text-zinc-900 font-bold">online sichtbar ist</strong>.
        Genau da setze ich an.
      </p>
    </div>

  </div>
</section>

<div class="h-px bg-gradient-to-r from-transparent via-zinc-200 to-transparent"></div>


<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     CHANCE  (dark)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
<section class="bg-zinc-950 py-28 px-6 relative overflow-hidden">
  <div class="pointer-events-none absolute top-0 right-0 w-[600px] h-[600px]
              bg-[radial-gradient(ellipse_at_top_right,rgba(249,115,22,.1)_0%,transparent_60%)]"></div>

  <div class="max-w-5xl mx-auto">

    <div class="reveal inline-flex items-center gap-2 bg-orange-500/10 border border-orange-500/20
                text-orange-400 text-xs font-bold uppercase tracking-[2.5px]
                px-3.5 py-1.5 rounded-full mb-6">
      Die Chance
    </div>

    <h2 class="reveal reveal-d1 font-black text-white leading-tight
               text-4xl sm:text-5xl mb-5 max-w-2xl">
      Maler haben einen riesigen<br/>
      Online-Vorteil –
      <span class="text-zinc-600"> sie nutzen ihn nur selten.</span>
    </h2>
    <p class="reveal reveal-d2 text-zinc-400 text-lg max-w-xl mb-14">
      Eure Arbeit ist von Natur aus visuell. Das ist das beste Rohmaterial
      für Social Media, das man sich vorstellen kann.
    </p>

    <div class="grid sm:grid-cols-3 gap-4">
      {[
        { icon:'📸', titel:'Vorher-Nachher ist unschlagbar', text:'Kein Content wirkt stärker auf Instagram als ein gutes Vorher-Nachher-Foto. Maler haben davon unendlich viele – sie zeigen sie nur nicht.' },
        { icon:'📍', titel:'Lokale Ads treffen genau eure Zielgruppe', text:'Mit Meta- oder Google-Anzeigen sprecht ihr gezielt Menschen in Freising und Umgebung an. Kein Streuverlust.' },
        { icon:'🚀', titel:'Die Konkurrenz schläft noch', text:'Kaum ein Malerbetrieb in der Region hat einen aktiven Online-Auftritt. Wer jetzt startet, baut einen Vorsprung auf.' },
      ].map((c, i) => (
        <div class={`reveal reveal-d${i + 1}
                     group relative overflow-hidden
                     bg-white/[.04] border border-white/[.07]
                     hover:border-orange-500/30 hover:bg-white/[.07]
                     rounded-2xl p-7
                     hover:-translate-y-1.5 transition-all duration-300`}>
          <span class="absolute top-4 right-5 text-6xl font-black text-white/[.04] leading-none select-none">
            0{i + 1}
          </span>
          <span class="text-3xl block mb-5">{c.icon}</span>
          <h3 class="text-white font-bold mb-3">{c.titel}</h3>
          <p class="text-zinc-500 text-sm leading-relaxed">{c.text}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<div class="h-px bg-gradient-to-r from-transparent via-orange-500/20 to-transparent"></div>


<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     LÖSUNG
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
<section id="loesung" class="bg-white py-28 px-6">
  <div class="max-w-5xl mx-auto">

    <div class="reveal inline-flex items-center gap-2 bg-orange-50 border border-orange-200
                text-orange-600 text-xs font-bold uppercase tracking-[2.5px]
                px-3.5 py-1.5 rounded-full mb-6">
      Was ich übernehme
    </div>

    <h2 class="reveal reveal-d1 font-black text-zinc-900 leading-tight
               text-4xl sm:text-5xl mb-4 max-w-2xl">
      Komplett betreut –<br/>
      <span class="text-zinc-300">ohne Aufwand für euch.</span>
    </h2>
    <p class="reveal reveal-d2 text-zinc-500 text-lg max-w-xl mb-14">
      Alles aus einer Hand. Ihr macht weiter euren Job –
      ich kümmere mich um den Rest.
    </p>

    <div class="grid sm:grid-cols-2 gap-4">
      {leistungen.map((l, i) => (
        <div class={`reveal reveal-d${i + 1}
                     group bg-zinc-50 hover:bg-white
                     border border-zinc-100 hover:border-orange-200
                     hover:shadow-[0_8px_40px_rgba(249,115,22,.08)]
                     rounded-2xl p-7
                     hover:-translate-y-1 transition-all duration-300
                     flex flex-col gap-5`}>

          <div class="flex items-center justify-between">
            <div class="w-11 h-11 rounded-xl
                        bg-orange-50 border border-orange-100
                        flex items-center justify-center text-lg
                        group-hover:bg-orange-100 group-hover:scale-110
                        transition-all duration-300">
              {l.icon}
            </div>
            <span class="text-3xl font-black text-zinc-100 select-none leading-none">
              {l.nr}
            </span>
          </div>

          <div>
            <h3 class="text-zinc-900 font-bold text-lg mb-2">{l.titel}</h3>
            <p class="text-zinc-500 text-sm leading-relaxed">{l.text}</p>
          </div>

          <div class="flex flex-wrap gap-2 pt-4 border-t border-zinc-100">
            {l.tags.map(t => (
              <span class="text-xs font-semibold px-3 py-1 rounded-full
                           bg-orange-50 text-orange-600 border border-orange-100">
                {t}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>


<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     TESTPHASE  (dark)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
<section id="testphase" class="bg-zinc-950 py-28 px-6 relative overflow-hidden">
  <div class="pointer-events-none absolute bottom-0 left-0 w-[600px] h-[600px]
              bg-[radial-gradient(ellipse_at_bottom_left,rgba(249,115,22,.09)_0%,transparent_60%)]"></div>

  <div class="max-w-5xl mx-auto">

    <div class="reveal inline-flex items-center gap-2 bg-orange-500/10 border border-orange-500/20
                text-orange-400 text-xs font-bold uppercase tracking-[2.5px]
                px-3.5 py-1.5 rounded-full mb-6">
      4-Wochen-Testphase
    </div>

    <h2 class="reveal reveal-d1 font-black text-white leading-tight
               text-4xl sm:text-5xl mb-5">
      Ich arbeite 4 Wochen<br/>
      <span class="bg-gradient-to-r from-orange-400 to-amber-400 bg-clip-text text-transparent">
        kostenlos für euch.
      </span>
    </h2>

    <!-- Cost callout -->
    <div class="reveal reveal-d2 flex flex-wrap items-center gap-6
                bg-white/[.04] border border-white/[.07] rounded-2xl px-8 py-6 mb-12
                max-w-2xl">
      <div>
        <p class="text-orange-400 font-black text-4xl leading-none tracking-tight">300–500 €</p>
        <p class="text-zinc-600 text-xs mt-1.5 font-medium">Werbebudget (geschätzt)</p>
      </div>
      <div class="h-10 w-px bg-white/10 hidden sm:block shrink-0"></div>
      <p class="text-zinc-400 text-sm leading-relaxed">
        Meine Zeit, Strategie und Umsetzung kosten euch
        <strong class="text-white">nichts</strong>.
        Ich will echte Ergebnisse beweisen.
      </p>
    </div>

    <!-- Weeks grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
      {wochen.map((w, i) => (
        <div class={`reveal reveal-d${i + 1} rounded-2xl p-6 flex flex-col gap-4 ${
          w.hot
            ? 'bg-orange-500/[.12] border border-orange-500/40 shadow-[0_0_40px_rgba(249,115,22,.12)]'
            : 'bg-white/[.03] border border-white/[.07]'
        }`}>
          <div>
            <p class={`text-[10px] font-black uppercase tracking-[3px] mb-1.5 ${
              w.hot ? 'text-orange-400' : 'text-zinc-700'
            }`}>{w.label}</p>
            <p class={`font-bold text-sm leading-snug ${w.hot ? 'text-white' : 'text-zinc-400'}`}>
              {w.titel}
            </p>
          </div>
          <ul class="flex flex-col gap-2 mt-1">
            {w.punkte.map(p => (
              <li class="flex gap-2 text-xs leading-snug">
                <span class="text-orange-500 shrink-0 mt-0.5 font-bold">✓</span>
                <span class={w.hot ? 'text-zinc-300' : 'text-zinc-600'}>{p}</span>
              </li>
            ))}
          </ul>
          {w.hot && (
            <div class="mt-auto pt-3 border-t border-orange-500/20">
              <span class="text-orange-400 text-[10px] font-bold uppercase tracking-widest">
                ← Ergebnisse spürbar
              </span>
            </div>
          )}
        </div>
      ))}
    </div>

  </div>
</section>

<div class="h-px bg-gradient-to-r from-transparent via-orange-500/20 to-transparent"></div>


