<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     ABLAUF (Timeline)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
<section id="ablauf" class="bg-white py-12 px-4 md:py-20 md:px-6 lg:py-24">
  <div class="max-w-6xl mx-auto">

    <div class="max-w-2xl mb-10 md:mb-14 lg:mb-16">
      <p class="reveal text-indigo-600 text-xs font-semibold uppercase tracking-[2.5px] mb-3 md:mb-4">
        Ablauf &amp; Zusammenarbeit
      </p>
      <h2 class="reveal reveal-d1 text-slate-900 font-bold tracking-tight
                 text-2xl sm:text-3xl md:text-4xl lg:text-5xl leading-tight mb-4 md:mb-5">
        Schritt für Schritt –<br/>
        <span class="text-slate-400 font-medium">unkompliziert.</span>
      </h2>
      <p class="reveal reveal-d2 text-slate-600 text-base md:text-lg leading-relaxed">
        Kein langer Vorlauf, kein Papierkram. In wenigen Tagen seid ihr startklar.
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative max-w-2xl">
      <!-- Vertical line (repositioned for smaller nodes on mobile) -->
      <div class="absolute left-[18px] md:left-5 top-5 bottom-5 w-px bg-slate-200"></div>

      <div class="flex flex-col gap-4 md:gap-5">
        {schritte.map((s, i) => (
          <div class={`reveal reveal-d${i + 1} group relative flex gap-4 md:gap-6 items-start`}>

            <!-- Node -->
            <div class="relative z-10 shrink-0
                        w-9 h-9 md:w-11 md:h-11 rounded-full
                        bg-white border-2 border-slate-200
                        group-hover:border-indigo-400 group-hover:bg-indigo-50
                        flex items-center justify-center
                        transition duration-300">
              <span class="text-slate-400 group-hover:text-indigo-600 font-bold text-xs transition duration-300">
                {s.nr}
              </span>
            </div>

            <!-- Content -->
            <div class="flex-1 bg-slate-50 hover:bg-white
                        border border-slate-200/60 rounded-2xl p-4 md:p-6
                        shadow-sm hover:shadow-md transition duration-300 hover:-translate-y-0.5">
              <div class="flex flex-wrap items-center gap-2 md:gap-3 mb-2">
                <h3 class="text-slate-900 font-semibold text-sm md:text-base">{s.titel}</h3>
                <span class="text-xs font-medium px-2.5 py-0.5 md:px-3 md:py-1 rounded-lg
                             bg-indigo-50 text-indigo-600 border border-indigo-100">
                  {s.dauer}
                </span>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed">{s.text}</p>
            </div>

          </div>
        ))}
      </div>
    </div>

  </div>
</section>


<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
