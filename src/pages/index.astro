    </div>

  </div>
</section>


<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     CTA
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
<section id="kontakt" class="relative bg-zinc-950 overflow-hidden">

  <!-- Top transition -->
  <div class="h-px bg-gradient-to-r from-transparent via-orange-500/30 to-transparent"></div>

  <!-- Full orange CTA block -->
  <div class="relative bg-gradient-to-br from-orange-500 via-orange-500 to-amber-500 py-28 px-6 overflow-hidden">

    <!-- Dot texture -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.12]
                [background-image:radial-gradient(circle,rgba(255,255,255,1)_1px,transparent_1px)]
                [background-size:22px_22px]"></div>

    <!-- Depth shadows -->
    <div class="absolute inset-0 pointer-events-none
                bg-gradient-to-b from-orange-600/40 via-transparent to-orange-700/30"></div>

    <!-- Glow blobs -->
    <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] h-[300px]
                bg-white/10 blur-[80px] rounded-full"></div>

    <div class="relative max-w-3xl mx-auto text-center">

      <!-- Badge -->
      <div class="reveal inline-flex items-center gap-2 bg-white/20 border border-white/30
                  text-white text-xs font-bold uppercase tracking-[2.5px]
                  px-4 py-1.5 rounded-full mb-8">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full rounded-full bg-white opacity-75 animate-ping"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-white"></span>
        </span>
        Noch 1–2 Plätze frei
      </div>

      <h2 class="reveal reveal-d1 text-white font-black leading-tight
                 text-4xl sm:text-5xl lg:text-6xl mb-5">
        Ich suche aktuell<br/>
        1–2 Malerbetriebe<br/>
        in Freising.
      </h2>

      <p class="reveal reveal-d2 text-orange-100 text-lg max-w-lg mx-auto mb-2 leading-relaxed">
        Bereit für planbare Anfragen aus der Region?<br/>
        Meldet euch – völlig unverbindlich.
      </p>
      <p class="reveal reveal-d3 text-orange-200/70 text-sm mb-12">
        Keine Kosten · Kein Vertrag · Keine Mindestlaufzeit
      </p>

      <!-- Contact cards -->
      <div class="reveal reveal-d4 grid sm:grid-cols-3 gap-3 max-w-2xl mx-auto mb-10">
        {[
          { icon: '📞', label: 'Telefon / WhatsApp', val: TELEFON,   href: `tel:${TELEFON}` },
          { icon: '✉️',  label: 'E-Mail',             val: EMAIL,     href: mailto },
          { icon: '📷',  label: 'Instagram / Web',    val: INSTAGRAM, href: '#' },
        ].map(k => (
          <a href={k.href}
             class="group bg-white/15 hover:bg-white/25 border border-white/25 hover:border-white/40
                    rounded-2xl p-5 text-left
                    hover:-translate-y-1 transition-all duration-200">
            <span class="text-2xl block mb-3">{k.icon}</span>
            <p class="text-white/60 text-[10px] font-bold uppercase tracking-wider mb-1">{k.label}</p>
            <p class="text-white font-bold text-sm break-all">{k.val}</p>
          </a>
        ))}
      </div>

      <!-- Main CTA -->
      <div class="reveal reveal-d5 flex flex-col items-center gap-4">
        <a href={mailto}
           class="group inline-flex items-center gap-3
                  bg-white hover:bg-zinc-50
                  text-orange-600 font-black text-lg
                  px-10 py-5 rounded-2xl
                  shadow-[0_8px_40px_rgba(0,0,0,.2)]
                  hover:shadow-[0_16px_50px_rgba(0,0,0,.3)]
                  hover:-translate-y-0.5 transition-all duration-200">
          Jetzt unverbindlich melden
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <p class="text-orange-200/60 text-sm">
          Kein Verkaufsgespräch. Ich erkläre meinen Ansatz – ihr entscheidet.
        </p>
      </div>

    </div>
  </div>

  <!-- Footer inside dark wrapper -->
  <footer class="bg-zinc-950 border-t border-white/[.05] py-8 px-6 text-center">
    <p class="text-zinc-700 text-sm">
      Social-Media-Marketing für Malerbetriebe · Freising &amp; Umgebung ·
      <a href={`mailto:${EMAIL}`} class="text-orange-500/60 hover:text-orange-400 transition-colors">
        {EMAIL}
      </a>
    </p>
  </footer>

</section>

</Layout>
